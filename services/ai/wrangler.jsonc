{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "push-be-python",
  // src/ is the upload root, so a repo-level .venv is not part of the bundle.
  // The public workers.dev name is the TypeScript gateway (services/gateway).
  // This worker is only reached through the front worker's service binding.
  // Chat jobs run on the redis ai-worker, not a Workflow.
  "main": "src/worker.py",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "rules": [{"type": "Data", "globs": ["app/resources/**/*.md"], "fallthrough": true}],
  "observability": {
    "enabled": true
  },
  // Empty crons delete the old minute nudge. Chat runs on the redis worker.
  "triggers": {
    "crons": []
  },
  "vars": {
    "APP_ENV": "production",
    "DB_DRIVER": "neon",
    "PG_TRANSPORT": "websocket",
    "RUN_MIGRATIONS": "0",
    "CHAT_EXECUTOR": "workflow",
    "LLM_STREAM": "1",
    "BLOB_STORE": "db",
    "SSE_MAX_POLLS": "20",
    "AI_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENCODE_GO_BASE_URL": "https://opencode.ai/zen/go/v1",
    "GOOGLE_GMAIL_BETA_ENABLED": "false",
    "STRIPE_SUCCESS_URL": "push://billing/success",
    "STRIPE_CANCEL_URL": "push://billing/cancel",
    "STRIPE_PORTAL_RETURN_URL": "push://billing/portal"
  }
}
