{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "push-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Neon runs in aws-ap-southeast-1; run next to it so each DB round trip stays short.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  // This script used to be the Python worker and still has that worker's
  // once-a-minute cron on Cloudflare. Omitting `triggers` does not delete
  // it, so the platform invokes this worker every minute and records
  // "Handler does not export a scheduled() function". An empty list is
  // what clears the schedule. The Python worker has no crons either.
  "triggers": { "crons": [] },
  // Public URL stays https://push-be.<account>.workers.dev.
  // Reads listed in src/handler.ts are answered here. Other non-AI
  // routes go to push-be-core. AI routes go to AI_ORIGIN.
  "services": [
    { "binding": "CORE", "service": "push-be-core" }
  ],
  "vars": {
    "APP_ENV": "production",
    // Availability flags for GET /ai/models. These are not secrets.
    // Set MANAGED_AI to "0" when the Python worker has no
    // OPENROUTER_API_KEY.
    "MANAGED_AI": "1",
    "SSE_MAX_POLLS": "20",
    "MODEL_CACHE_TTL": "600",
    "JOB_SITES_CACHE_TTL": "3600",
    "AUTH_CACHE_TTL": "5"
  },
  // Test server: push-be-staging.<account>.workers.dev, deployed from develop with
  // `wrangler deploy --env staging`. vars and services do not inherit, so they repeat.
  // APP_ENV=development turns on DEV_AUTH_TOKEN sign-in.
  "env": {
    "staging": {
      "name": "push-be-staging",
      "triggers": { "crons": [] },
      "services": [
        { "binding": "CORE", "service": "push-be-core-staging" }
      ],
      "vars": {
        "APP_ENV": "development",
        // The AI service seeds this user at startup when DEV_AUTH_TOKEN is set.
        "DEV_USER_ID": "00000000-0000-4000-8000-000000000001",
        "MANAGED_AI": "1",
        "SSE_MAX_POLLS": "20",
        "MODEL_CACHE_TTL": "600",
        "JOB_SITES_CACHE_TTL": "3600",
        "AUTH_CACHE_TTL": "5"
      }
    }
  }
}
