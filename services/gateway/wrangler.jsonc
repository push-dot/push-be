{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "push-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Neon runs in aws-ap-southeast-1; run next to it so each DB round trip stays short.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  // This script used to be the Python worker and still has that worker's
  // once-a-minute cron on Cloudflare. Omitting `triggers` does not delete
  // it, so the platform invokes this worker every minute and records
  // "Handler does not export a scheduled() function". An empty list is
  // what clears the schedule. The Python worker keeps `* * * * *`.
  "triggers": { "crons": [] },
  // Public URL stays https://push-be.<account>.workers.dev.
  // Reads listed in src/handler.ts are answered here. Other non-AI
  // routes go to push-be-core. AI routes go to push-be-python.
  "services": [
    { "binding": "API", "service": "push-be-python" },
    { "binding": "CORE", "service": "push-be-core" }
  ],
  "vars": {
    "APP_ENV": "production",
    // Availability flags for GET /ai/models. These are not secrets.
    // Set MANAGED_AI to "0" when the Python worker has neither
    // OPENROUTER_API_KEY nor OPENAI_API_KEY. Set MANAGED_GO to "1"
    // when OPENCODE_GO_API_KEY is set on the Python worker.
    "MANAGED_AI": "1",
    "MANAGED_GO": "0",
    "SSE_MAX_POLLS": "20",
    "MODEL_CACHE_TTL": "600",
    "JOB_SITES_CACHE_TTL": "3600",
    "AUTH_CACHE_TTL": "5"
  }
}
