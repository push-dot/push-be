APP_ENV=development
PORT=8080
DATABASE_URL=postgres://push:push@localhost:5434/push?sslmode=disable

# asyncpg (local docker and the VPS) or neon (Neon wire protocol on a *.neon.tech host).
# Leave unset to auto-select from the host. The VPS sets asyncpg.
DB_DRIVER=
# tcp (laptop, VPS, migrations) or websocket (Neon wss://<host>/v2).
PG_TRANSPORT=
# 0 on the VPS. Apply migrations from a machine that can open 5432:
#   python services/ai/scripts/migrate.py
RUN_MIGRATIONS=1
# local on the VPS. external turns the in-process chat poller off.
# workflow does not.
CHAT_EXECUTOR=
# 1 streams tokens. 0 stores one completion, then 48-character SSE chunks.
LLM_STREAM=1
# How many DB polls one SSE response may do. The gateway has its own cap.
SSE_MAX_POLLS=
# db stores sources and resume files in Postgres. Empty uses the filesystem.
# The VPS sets db.
BLOB_STORE=
# Empty uses langgraph-checkpoint-postgres when installed. The VPS sets postgres.
CHECKPOINTER=

# postgres keeps the in-process chat poller. redis runs jobs from Redis Streams
# (needs REDIS_URL and the dispatcher/worker processes in services/ai/src/app/workers).
QUEUE_BACKEND=postgres
REDIS_URL=redis://localhost:6379/0
# tei (embed/rerank containers) or api (OpenAI-compatible /embeddings, 1024 dimensions).
EMBEDDING_PROVIDER=tei
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
# Browser Rendering REST API (Workers free: 10 minutes/day). Optional.
CF_ACCOUNT_ID=
CF_API_TOKEN=

DEV_AUTH_TOKEN=
DEV_USER_ID=00000000-0000-4000-8000-000000000001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PHONE_SMS_MODE=
PHONE_CODE_COOLDOWN_SEC=168
PHONE_CODE_TTL_SEC=180
PHONE_CODE_MAX_ATTEMPTS=5
PENDING_SIGNUP_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_PRIVATE_KEY=
MAIL_FROM="Push <no-reply@push.mail.devcyjoon.tech>"
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=
INTERNAL_JOB_TOKEN=
APP_WEB_ORIGIN=
OAUTH_REDIRECT_ORIGINS=
NTS_SERVICE_KEY=

OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
MODEL_FREE=
MODEL_PRO=
MODEL_ULTRA=
MODEL_EMPLOYER_ULTRA=
OPENROUTER_DEEPSEEK_PROVIDERS=
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
TOKEN_ENCRYPTION_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_EMPLOYER_BASIC=
STRIPE_PRICE_EMPLOYER_PRO=
STRIPE_PRICE_EMPLOYER_ULTRA=
STRIPE_PRICE_TOPUP=
IAP_PRODUCT_PRO=
IAP_PRODUCT_ULTRA=
IAP_PRODUCT_TOPUP=
IAP_TOPUP_CREDITS=
APPLE_IAP_KEY=
APPLE_ROOT_PEM=
GOOGLE_PLAY_KEY=
GOOGLE_PLAY_PACKAGE=
GOOGLE_OIDC_AUDIENCE=
GOOGLE_OIDC_KEY=
STRIPE_SUCCESS_URL=push://billing/success
STRIPE_CANCEL_URL=push://billing/cancel
STRIPE_PORTAL_RETURN_URL=push://billing/portal

STORAGE_DIR=./data/sources
# Shared with the gateway as the x-push-ai-secret header.
# The gateway sets it on the hop to AI_ORIGIN. Required in production.
AI_SHARED_SECRET=
INTERNAL_API_SECRET=
CORE_ORIGIN=
GOOGLE_GMAIL_BETA_ENABLED=false

EXPERIMENTS=[{"key":"home-greeting","variants":["A","B"],"exclusion_group":"home-hero"},{"key":"home-cta","variants":["A","B"],"exclusion_group":"home-hero"},{"key":"stream-render","variants":["A","B"],"exclusion_group":"chat-core"},{"key":"approval-surface","variants":["A","B"],"exclusion_group":"chat-core"}]
