# Copy to a secret store or Dokploy env. Do not commit filled-in values.
# The VPS process reads these. AI_ORIGIN is a gateway Worker variable, not this file.

# --- VPS (Dokploy) ---
DATABASE_URL=
AI_SHARED_SECRET=
AI_HOST=
APP_ENV=production
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
BYOK_MASTER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MAIL_FROM=
APP_WEB_ORIGIN=
OAUTH_REDIRECT_ORIGINS=
NTS_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_EMPLOYER_BASIC=
STRIPE_PRICE_EMPLOYER_PRO=
STRIPE_PRICE_EMPLOYER_ULTRA=
STRIPE_PRICE_TOPUP=
IAP_PRODUCT_PRO=
IAP_PRODUCT_ULTRA=
IAP_PRODUCT_TOPUP=
IAP_TOPUP_CREDITS=
APPLE_IAP_KEY=
GOOGLE_PLAY_KEY=
GOOGLE_PLAY_PACKAGE=
STORAGE_DIR=/data/sources
CHAT_EXECUTOR=local
# legacy until a turn is verified. langchain opts into LangChain + LlamaIndex.
AI_FRAMEWORK=legacy
CHECKPOINTER=postgres
DB_DRIVER=asyncpg
PG_TRANSPORT=tcp
RUN_MIGRATIONS=0
PORT=8080

# --- Gateway Worker dashboard (not wrangler.jsonc, not the VPS) ---
# Leave both unset to keep the push-be-python service binding.
# AI_ORIGIN=https://ai.example.com
# AI_SHARED_SECRET=  (same value as the VPS)
