# Reference list only. Nobody fills this in: the deploy job writes /opt/push-be/.env
# from GitHub Actions secrets and variables (see README.md for which is which).
# For a local `docker compose config`, copy it and fill placeholders; never commit values.
# AI_ORIGIN is a gateway and core deploy var (https://$AI_HOST), not this file.

# --- VPS ---
DATABASE_URL=
AI_SHARED_SECRET=
AI_HOST=push.devcyjoon.tech
APP_ENV=production
OPENROUTER_API_KEY=
OPENAI_API_KEY=
MODEL_FREE=
MODEL_PRO=
MODEL_ULTRA=
MODEL_EMPLOYER_ULTRA=
OPENROUTER_DEEPSEEK_PROVIDERS=
AI_BASE_URL=https://openrouter.ai/api/v1
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MAIL_FROM="Push <no-reply@push.mail.devcyjoon.tech>"
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=
INTERNAL_JOB_TOKEN=
APP_WEB_ORIGIN=
OAUTH_REDIRECT_ORIGINS=
NTS_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_EMPLOYER_BASIC=
STRIPE_PRICE_EMPLOYER_PRO=
STRIPE_PRICE_EMPLOYER_ULTRA=
STRIPE_PRICE_TOPUP=
IAP_PRODUCT_PRO=
IAP_PRODUCT_ULTRA=
IAP_PRODUCT_TOPUP=
IAP_TOPUP_CREDITS=
APPLE_IAP_KEY=
APPLE_ROOT_PEM=
GOOGLE_PLAY_KEY=
GOOGLE_PLAY_PACKAGE=
GOOGLE_OIDC_AUDIENCE=
GOOGLE_OIDC_KEY=
STORAGE_DIR=/data/sources
CHAT_EXECUTOR=local
CHECKPOINTER=postgres

# --- Queue (redis, dispatcher, workers) ---
# redis runs chat, documents, fit, ingest and notify jobs from Redis Streams.
# postgres rolls back to the in-process chat poller in ai. Set the same value on push-be-core.
QUEUE_BACKEND=redis
# Long random string. Redis has no published port; only push-internal reaches it.
REDIS_PASSWORD=
# Host name Traefik routes to the dispatcher. Core calls https://<DISPATCH_HOST>/internal/kick.
DISPATCH_HOST=
# Same value as DISPATCH_SECRET on push-be-core.
DISPATCH_SECRET=
# Bearer token for /admin/* on the dispatcher.
ADMIN_TOKEN=
# Alerts. Discord first; Resend mail (RESEND_API_KEY) when the webhook fails.
DISCORD_ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
NEON_STORAGE_LIMIT_BYTES=1073741824
AI_WORKER_CONCURRENCY=3
INGEST_WORKER_CONCURRENCY=2
# Optional overrides (seconds). Defaults: chat 120, employer_ai 120, document 300, fit 180, ingest 600, notify 60.
# HEARTBEAT_LIMIT_CHAT_S=
# HEARTBEAT_LIMIT_EMPLOYER_AI_S=
# HEARTBEAT_LIMIT_DOCUMENT_S=
# HEARTBEAT_LIMIT_FIT_S=
# HEARTBEAT_LIMIT_INGEST_S=
# HEARTBEAT_LIMIT_NOTIFY_S=

# --- Embeddings and RAG ---
# tei uses the embed/rerank containers. api uses an OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=tei
# similarity reranks with embedding cosine. tei needs the rerank compose profile (about 2.5 GB more).
RERANK_PROVIDER=similarity
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=openai/text-embedding-3-small
# llamaindex searches rag_nodes and is the default. legacy keeps rag_chunks.
# Reindex old uploads first: enqueue {"reindex": true} on q:ingest, then run eval/rag/run_eval.py for legacy and llamaindex.
RAG_ENGINE=llamaindex
DB_DRIVER=asyncpg
PG_TRANSPORT=tcp
RUN_MIGRATIONS=0
PORT=8080

# --- Gateway and core Workers (CI writes their secrets with wrangler secret bulk; not the VPS) ---
# push-be and push-be-core get AI_ORIGIN from the deploy command:
#   npx wrangler deploy --var AI_ORIGIN:https://${AI_HOST}
# An empty AI_HOST makes that value the literal https://
# There is no push-be-python service binding. An empty origin returns 500.
# AI_SHARED_SECRET=  (same value as the VPS; the gateway sends x-push-ai-secret)
# push-be-core only:
# QUEUE_BACKEND=redis  (same value as the VPS)
# DISPATCH_ORIGIN=https://<DISPATCH_HOST>
# DISPATCH_SECRET=  (same value as the VPS)
# The postgres rollback also needs AI_ORIGIN. Redis chat uses the dispatcher kick.
# INTERNAL_API_SECRET=  (core act-as secret; same value on the AI service)
# CORE_ORIGIN=  (core origin the AI service calls for tool act-as)
# AI_HARNESS=  (1 enables the harness graph on the VPS; unset keeps the legacy graph.)
