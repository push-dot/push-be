{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "push-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Public URL stays https://push-be.<account>.workers.dev.
  // Chat generation and every route not listed in src/handler.ts go to
  // the Python worker through this binding.
  "services": [
    { "binding": "API", "service": "push-be-python" }
  ],
  "vars": {
    "APP_ENV": "production",
    // Availability flags for GET /ai/models. These are not secrets.
    // Set MANAGED_AI to "0" when the Python worker has neither
    // OPENROUTER_API_KEY nor OPENAI_API_KEY. Set MANAGED_GO to "1"
    // when OPENCODE_GO_API_KEY is set on the Python worker.
    "MANAGED_AI": "1",
    "MANAGED_GO": "0",
    "SSE_MAX_POLLS": "20",
    "MODEL_CACHE_TTL": "600",
    "JOB_SITES_CACHE_TTL": "3600"
  }
}
